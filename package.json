{
  "name": "domner-app",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Domner App — Cambodia's first Khmer-language travel super app",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:workspaces": "npm run build --workspaces --if-present",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "lint:workspaces": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\"",
    "dev:ops": "npm run dev --workspace @domner/ops",
    "dev:worker": "npm run dev --workspace @domner/worker",
    "intents:gap": "node scripts/intent-gap.mjs",
    "intents:seed": "node scripts/seed-data.mjs",
    "intents:generate": "node scripts/generate-questions.mjs",
    "intents:train": "node scripts/train-intent.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock": "tsx mock-gohub/src/server.ts",
    "test:contract": "vitest run --config vitest.contract.mts",
    "audit:check": "node scripts/audit-check.mjs",
    "supabase:check": "node scripts/supabase-check.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@hookform/resolvers": "^3.9.0",
    "@stripe/stripe-js": "^4.8.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.45.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.11.0",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.454.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "resend": "^4.0.0",
    "stripe": "^17.2.0",
    "three": "^0.185.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.1",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "express": "^4.22.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
