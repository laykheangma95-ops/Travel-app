# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ABA PayWay
# Leave MERCHANT_ID/API_KEY blank to keep checkout in demo mode.
ABA_MERCHANT_ID=
ABA_API_KEY=
# Only set if ABA issued a separate pushback secret; defaults to ABA_API_KEY.
ABA_WEBHOOK_SECRET=
# Sandbox: https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
ABA_CHECKOUT_URL=
# Blank = show all methods ABA enabled. Or force one, e.g. abapay_khqr / cards.
ABA_PAYMENT_OPTION=

# AeroDataBox
RAPIDAPI_KEY=
AEROBOX_HOST=aerodatabox.p.rapidapi.com

# AI chatbot (Domner Trip Copilot) — OpenRouter key (sk-or-v1-...), routes to Claude.
OPENROUTER_API_KEY=

# Firebase
NEXT_PUBLIC_FIREBASE_CONFIG=
FIREBASE_ADMIN_SDK=

# Resend Email
RESEND_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Admin
ADMIN_EMAIL=

# App
NEXT_PUBLIC_APP_URL=https://domnerapp.com
