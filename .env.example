# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ABA PayWay
ABA_MERCHANT_ID=
ABA_API_KEY=
ABA_WEBHOOK_SECRET=

# AeroDataBox
RAPIDAPI_KEY=
AEROBOX_HOST=aerodatabox.p.rapidapi.com

# AI chatbot (Domner Trip Copilot) — OpenRouter key (sk-or-v1-...), routes to Claude.
OPENROUTER_API_KEY=

# Firebase
NEXT_PUBLIC_FIREBASE_CONFIG=
FIREBASE_ADMIN_SDK=

# Resend Email
RESEND_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Admin
ADMIN_EMAIL=

# Corner Map (ជ្រុង) — Protomaps basemap. OPTIONAL.
# Leave blank and the map falls back to CARTO dark raster tiles, tinted onto
# the Corner palette — the same tiles the flight tracker already uses. Nothing
# to configure to get a working map.
#
# Set this once traffic justifies it: a self-hosted .pmtiles archive has no
# per-load cost, which is why the spec picks Protomaps for Cambodia volumes.
#   pmtiles extract https://build.protomaps.com/YYYYMMDD.pmtiles cambodia.pmtiles \
#     --bbox=102.3,9.9,107.7,14.7
# then upload it to Supabase Storage / R2 / S3 and point this at the public URL.
NEXT_PUBLIC_PMTILES_URL=

# App
NEXT_PUBLIC_APP_URL=https://domnerapp.com
