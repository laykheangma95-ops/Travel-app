# ─────────────────────────────────────────────────────────────────────────────
# Domner App environment
#
# In DEVELOPMENT every variable is optional — unconfigured services fall back to
# clearly-labelled demo behavior.
#
# In PRODUCTION that fallback is disabled. A missing key causes a 503, never a
# free order. Check /api/health after deploying to see what is still missing.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required in production ───────────────────────────────────────────────────

# Supabase — auth, orders, saved flights. Set the schema up first with
# ./scripts/supabase-bootstrap.sh — schema.sql on its own leaves the database
# missing every migration. See docs/SUPABASE-PROJECTS.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Bypasses Row Level Security — server-side only. Never
# expose it to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=

# Stripe — international card payments.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Without this, payment webhooks cannot be verified and no order can settle.
STRIPE_WEBHOOK_SECRET=

# Owner break-glass access. Comma-separated. An empty value means NOBODY gets
# in — the panel fails closed rather than open.
#
# This is NOT the whole access story any more: day-to-day staff authority lives
# in the staff_users table and is managed at /admin/staff. ADMIN_EMAIL stays as
# the way back in when that table is empty, wrong, or someone removes their own
# admin row by mistake. Keep it set to the owner's address and use roles for
# everyone else. See docs/STAFF-ROLES.md.
ADMIN_EMAIL=

# Require a second factor on staff accounts. Leave unset until everyone has
# enrolled — switching it on locks out every account that has not. /admin/staff
# shows who has enrolled, so you can see when it is safe.
STAFF_REQUIRE_MFA=

# Public base URL, used for return URLs, emails, sitemap and canonical links.
NEXT_PUBLIC_APP_URL=https://domnerapp.com

# ── Payments (Cambodia) ──────────────────────────────────────────────────────

ABA_MERCHANT_ID=
ABA_API_KEY=
ABA_WEBHOOK_SECRET=
# Override only if ABA gives you a different endpoint.
# ABA_CHECKOUT_URL=

# ── Notifications ────────────────────────────────────────────────────────────

# Resend — order confirmation and eSIM delivery emails.
RESEND_API_KEY=
# RESEND_FROM="Domer <orders@domnerapp.com>"

# Firebase Cloud Messaging — push notifications.
NEXT_PUBLIC_FIREBASE_CONFIG=
FIREBASE_ADMIN_SDK=

# Telegram — admin order alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Bot username without '@' — used to build the t.me deep link that connects a
# customer's chat so we can deliver their eSIM QR there.
TELEGRAM_BOT_USERNAME=
# Shared secret passed to setWebhook; the webhook route refuses to run without it.
TELEGRAM_WEBHOOK_SECRET=

# ── eSIM suppliers ───────────────────────────────────────────────────────────
#
# Supplier routing. Orders go to the first supplier in this list that is
# configured, healthy, and carries the plan. Reordering it switches supplier
# for every future order — no deploy needed.
#   ESIM_PROVIDER_ORDER=airalo,esimgo,sandbox
ESIM_PROVIDER_ORDER=

# Plan → supplier SKU mapping, as JSON. Overrides the built-in table so a SKU
# correction does not need a deploy. See docs/ADDING-A-SUPPLIER.md.
#   ESIM_SKU_MAP={"airalo":{"thailand-standard":"ARL-TH-7D-2GB"}}
ESIM_SKU_MAP=

# Sandbox supplier — issues fake eSIMs that will NOT connect to a real network.
# On by default in development. In production it additionally requires
# DOMNER_ALLOW_DEMO, so a customer can never receive one by accident.
# ESIM_SANDBOX_ENABLED=true
# Fraction of sandbox provisioning calls that fail, for rehearsing failover.
# ESIM_SANDBOX_FAILURE_RATE=0

# Real supplier credentials go here once contracts are signed, e.g.
# AIRALO_BASE_URL=
# AIRALO_API_KEY=

# ── GoHub (B2B eSIM supplier) ────────────────────────────────────────────────
#
# Switching between the local mock and production is these five values and
# nothing else. No code changes, no rebuild of the client.
#
#   Local mock:  npm run mock, then GOHUB_BASE_URL=http://localhost:4000/api
#   Production:  the base URL, partner id and key GoHub issue us
#
# Never commit real credentials. GOHUB_API_KEY is redacted from every log line.
GOHUB_BASE_URL=
GOHUB_PARTNER_ID=
GOHUB_API_KEY=
# Verifies the X-hmac-signature on inbound fulfilment webhooks. An unsigned or
# wrongly-signed webhook is rejected, so this must match what GoHub holds.
GOHUB_HMAC_SECRET=
# Per-attempt timeout. Retries are 3 attempts with backoff on 5xx and timeouts.
GOHUB_TIMEOUT_MS=15000
# Optional. Also append the raw request/response log to this JSONL file. Leave
# empty in production — the filesystem is read-only and the platform log drain
# already collects the structured lines.
GOHUB_API_LOG_PATH=

# ── mock-gohub (development only) ────────────────────────────────────────────
#
# The fake GoHub server in mock-gohub/. Never runs in production, never imported
# by application code. Defaults work with an empty .env — see mock-gohub/README.md.
#
# MOCK_PORT=4000
# Must match GOHUB_PARTNER_ID / GOHUB_API_KEY above.
# MOCK_PARTNER_ID=domner-mock-partner
# MOCK_API_KEY=domner-mock-key
# Must match GOHUB_HMAC_SECRET above.
# MOCK_HMAC_SECRET=domner-mock-hmac-secret
# MOCK_STARTING_BALANCE=5000000
# MOCK_FULFILL_DELAY_MS=5000
# MOCK_WEBHOOK_URL=http://localhost:3000/api/webhooks/gohub
# Sends every webhook twice, to prove our handler is idempotent.
# MOCK_WEBHOOK_DUPLICATE=false

# ── Flight data ──────────────────────────────────────────────────────────────

# AeroDataBox via RapidAPI — scheduled status, gates, delays.
# Live ADS-B tracking needs no key at all.
RAPIDAPI_KEY=
AEROBOX_HOST=aerodatabox.p.rapidapi.com

# ── Operational ──────────────────────────────────────────────────────────────

# Shared secret for scheduled jobs (the flight alert sender). Generate with:
#   openssl rand -hex 32
DOMNER_SERVICE_TOKEN=

# Salt for hashing IPs in affiliate click deduplication. Any long random string.
DOMNER_IP_SALT=

# debug | info | warn | error. Defaults to info in production.
LOG_LEVEL=

# DANGEROUS. Allows demo payment fallbacks in a production build — orders
# settle without money changing hands. Only ever set this on a staging deploy,
# never on the deployment real customers can reach.
# DOMNER_ALLOW_DEMO=true
